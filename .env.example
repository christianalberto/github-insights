# GitHub Personal Access Token (classic)
# Create one at: https://github.com/settings/tokens
# Use "Generate new token (classic)" and enable:
#   - repo        → required to include private repositories
#   - read:user   → read profile data
# Also enable "Include private contributions on my profile" in
# GitHub Settings → Public profile → Contributions & Activity
GITHUB_TOKEN=your_github_token_here

# Require the looked-up GitHub user to have starred this repo before
# /api/insight and /api/contrib-3d will generate cards (default: true).
# Set to false for local development without the star check.
REQUIRE_REPO_STAR=true

# Repo that users must star (defaults shown)
STAR_REPO_OWNER=christianalberto
STAR_REPO_NAME=github-insights
